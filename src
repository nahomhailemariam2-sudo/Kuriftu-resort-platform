@import '../../scss/variables.scss';

#reservation-modal {
  position: fixed;
  inset: 0;
  background-color: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.5s var(--transition-smooth), visibility 0.5s var(--transition-smooth);
  z-index: 3000;

  &.is-active {
    opacity: 1;
    visibility: visible;

    .modal-container {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0);
    }

    // Staggered cascade animation for interior elements
    .stagger-item {
      opacity: 1;
      transform: translateY(0);
      
      @for $i from 1 through 6 {
        &:nth-child(#{$i}) {
          transition: opacity 0.6s var(--transition-smooth) #{0.15 + ($i * 0.08)}s, 
                      transform 0.6s var(--transition-smooth) #{0.15 + ($i * 0.08)}s;
        }
      }
    }
  }

  .modal-container {
    background: var(--color-surface);
    width: 90%;
    max-width: 720px;
    padding: 3.5rem;
    border-radius: 20px;
    box-shadow: var(--shadow-luxury);
    opacity: 0;
    transform: scale(0.9) translateY(40px);
    filter: blur(8px);
    transition: all 0.6s var(--transition-smooth);
    position: relative;
    border-top: 5px solid var(--color-gold);
    border: 1px solid var(--glass-border);

    .modal-close {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      background: transparent;
      border: none;
      font-size: 2rem;
      color: var(--color-primary-dark);
      cursor: pointer;
      transition: color 0.2s ease, transform 0.2s ease;

      &:hover {
        color: var(--color-gold);
        transform: rotate(90deg);
      }
    }

    .stagger-item {
      opacity: 0;
      transform: translateY(20px);
      will-change: opacity, transform;
    }
  }

  .modal-header {
    margin-bottom: 2rem;
    h3 {
      font-family: var(--font-primary);
      font-size: 2.25rem;
      color: var(--color-primary-dark);
      margin-bottom: 0.5rem;
    }
    p {
      color: var(--color-muted);
      font-family: var(--font-sans);
    }
  }

  .modal-form {
    display: grid;
    gap: 1.5rem;

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;

      label {
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--color-primary-dark);
        letter-spacing: 0.025em;
      }

      input, select {
        padding: 0.875rem 1rem;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;

        &:focus {
          outline: none;
          border-color: var(--color-gold);
          box-shadow: 0 0 0 3px rgba(197, 168, 128, 0.15);
        }
      }
    }

    .btn-submit {
      background-color: var(--color-primary-dark);
      color: var(--color-surface);
      padding: 1rem;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: background-color 0.3s ease, transform 0.2s ease;
      margin-top: 1rem;

      &:hover {
        background-color: var(--color-gold);
        transform: translateY(-2px);
      }
    }
  }
}
